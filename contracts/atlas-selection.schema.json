{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://groundzerogames.net/contracts/atlas-selection.schema.json",
  "title": "A.T.L.A.S. selection payload",
  "type": "object",
  "required": [
    "schema",
    "deployable",
    "selection"
  ],
  "properties": {
    "schema": {
      "const": "gzg.atlas.selection/1.0"
    },
    "deployable": {
      "type": "boolean"
    },
    "selection": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "maxLength": 80
        },
        "name": {
          "type": "string",
          "maxLength": 160
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
